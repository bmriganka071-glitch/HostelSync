# ==========================================
# HostelSync Backend Environment Variables
# ==========================================

# Flask
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Server
HOST=127.0.0.1
PORT=5000

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hostelsync
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# JWT Authentication
JWT_SECRET_KEY=your_dummy_jwt_secret_here

# Optional
JWT_ACCESS_TOKEN_EXPIRES=3600