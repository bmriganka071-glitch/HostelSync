# ==========================================
# HostelSync Backend Environment Variables
# ==========================================

# Flask
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Server
HOST=127.0.0.1
PORT=5000

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hostelsync
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# JWT Authentication
JWT_SECRET_KEY=your_dummy_jwt_secret_here
INITIAL_ADMIN_SETUP_KEY=replace_with_a_long_random_secret

# Password reset email (SMTP credentials from your email provider)
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=HostelSync <no-reply@example.com>

# Optional
JWT_ACCESS_TOKEN_EXPIRES=3600
